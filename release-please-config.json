{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "packages": {
    "plugins/favo-estudo": {
      "release-type": "simple",
      "package-name": "favo-estudo",
      "component": "favo-estudo",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/favo-trilhas": {
      "release-type": "simple",
      "package-name": "favo-trilhas",
      "component": "favo-trilhas",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/favo-carreira": {
      "release-type": "simple",
      "package-name": "favo-carreira",
      "component": "favo-carreira",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Novidades"
    },
    {
      "type": "fix",
      "section": "Correções"
    },
    {
      "type": "docs",
      "section": "Documentação"
    },
    {
      "type": "refactor",
      "section": "Reorganização",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Manutenção",
      "hidden": true
    }
  ]
}
